/* demo.wxss: vertical swiper + horizontal scroll-view snap styles */

.full-swiper {
  width: 100%;
  height: 100vh;
}

.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.page-title {
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 900;
}

.page-tip {
  color: #888888;
  font-size: 26rpx;
  margin-top: 20rpx;
}

/* Inner horizontal scroll container */
.h-scroll {
  width: 100%;
  height: 100vh;
}

/* Horizontal track: flex layout (with enable-flex) */
.h-track {
  display: flex;
  flex-direction: row;
  height: 100%;
}

/* Each panel takes one viewport width */
.h-panel {
  flex: 0 0 100vw;
  width: 100vw;
  height: 100%;
}

/* Vertical scroll area inside panel B */
.v-scroll {
  width: 100%;
  height: 0;
  flex: 1;
  margin-top: 40rpx;
}

.item {
  height: 120rpx;
  margin: 0 40rpx 20rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.no-more {
  text-align: center;
  color: #888888;
  font-size: 24rpx;
  padding: 20rpx 0 40rpx;
}
