/* demo.wxss: permanent floating pill glass tabbar with centered raised logo */

.page {
  width: 100%;
  height: 100vh;
  background-color: #000000;
}

.content {
  color: #ffffff;
  text-align: center;
  padding-top: 40vh;
}

.tabbar-spacer {
  height: 160rpx;
}

/* Floating pill: inset from edges, large radius, glass blur */
.tabbar-pill {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 112rpx;
  display: flex;
  align-items: center;
  border-radius: 56rpx;
  backdrop-filter: blur(20px);
  background-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  color: rgba(255, 255, 255, 0.55);
}

.tab-item.active {
  color: #ffffff;
}

/* Plain text label (outline/line style preferred over filled/emoji icons) */
.tab-text {
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* Gap reserved for the raised logo */
.tab-gap {
  width: 120rpx;
  flex-shrink: 0;
}

/* Centered raised logo button */
.tab-logo {
  position: fixed;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.4);
  z-index: 101;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo-img {
  width: 72rpx;
  height: 40rpx;
}
